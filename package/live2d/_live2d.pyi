    def GetParamMaxById(self, id: str) -> float: ...
    def GetParamMinById(self, id: str) -> float: ...
    def GetParamDefaultById(self, id: str) -> float: ...
    def SetParamByIndex(self, index: int, value: float, weight: float = 1.0) -> None: ...
    def SetParamById(self, id: str, value: float, weight: float = 1.0) -> None: ...
    def AddParamByIndex(self, index: int, value: float) -> None: ...
    def AddParamById(self, id: str, value: float) -> None: ...
    def SetSaveParamByIndex(self, index: int, value: float, weight: float = 1.0) -> None: ...
    def SetSaveParamById(self, id: str, value: float, weight: float = 1.0) -> None: ...
