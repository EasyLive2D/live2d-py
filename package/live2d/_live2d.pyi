    def GetCanvasSize(self) -> tuple[float, float]: ...
    def GetCanvasSizePixel(self) -> tuple[float, float]: ...
    def GetPixelsPerUnit(self) -> int: ...
    def SetAutoBreath(self, on: bool) -> None: ...
    def SetAutoBlink(self, on: bool) -> None: ...
    def HasMocConsistencyFromFile(self, name: str) -> bool: ...
    def ResetPose(self) -> None: ...

    # ---- 渲染 ----
    def CreateRenderer(self, maskBufferCount: int = 1) -> None: ...
    def DestroyRenderer(self) -> None: ...
    def Draw(self) -> None: ...


def init() -> None:
    """Initialize platform manager."""
    ...

def glInit() -> None:
    """Initialize OpenGL function pointers and select the OpenGL backend.

    Raises RuntimeError if a backend (OpenGL or Vulkan) is already initialized,
    or if this build/platform does not support OpenGL.
    """
    ...

def glRelease() -> None:
    """Release OpenGL resources and reset the backend state (no-op when idle).

    Raises RuntimeError if the current backend is Vulkan.
    """
    ...

def dispose() -> None:
    """Release all live2d resources."""
    ...

def clearBuffer(r: float = 0.0, g: float = 0.0, b: float = 0.0, a: float = 0.0) -> None:
    """Clear color buffer."""
    ...

# ---- Vulkan backend ----
# vk* 入口在所有构建的 pyd 中都存在：
#   - 当前后端不是 Vulkan（含未初始化/已销毁）时抛 RuntimeError
#   - 该平台未编译 Vulkan 支持时抛 RuntimeError

def vkInit(platform: int, window_ptr: int, display_ptr: int, connection: int) -> None:
    """Initialize Vulkan instance/device/swapchain and select the Vulkan backend.

    Raises RuntimeError if a backend (OpenGL or Vulkan) is already initialized,
    or if this build/platform does not support Vulkan.

    window_ptr: 原生窗口句柄（Windows: HWND，可经 glfwGetWin32Window 获取）
    display_ptr: 显示连接（X11/Wayland 用，Windows 传 0）
    surface 创建由 VulkanManager 内部的平台标准 vkCreate*Surface 完成；
    所需实例扩展 (VK_KHR_surface / VK_KHR_win32_surface / debug_utils)
    由 native 层自动补齐，无需从 Python 传入。
    shader 经 FileUtils::LoadFileAsBytes 从 SHADER_DIR 加载，无需 chdir。
    """
    ...

def vkDestroy() -> None:
    """Destroy Vulkan resources and reset the backend state (no-op when idle).

    Raises RuntimeError if the current backend is OpenGL.
    """
    ...

def vkGetHandles() -> dict[str, int]:
    """取 Vulkan 运行时句柄（vkInit 成功后调用）。

    返回映射：
      physical_device  int  VkPhysicalDevice 指针
      device           int  VkDevice 指针
      color_format     int  交换链图像格式 (VkFormat)
      frames_in_flight int  帧在飞数量（in-flight fence 数）
    """
    ...

def vkBeginFrame() -> tuple[int, int, int, int] | None:
    """开始一帧：acquire 图像、打开渲染区间并清屏。

    返回 (cmd_buffer, image_index, width, height)；cmd_buffer 为当前帧命令
    缓冲指针，Draw() 会向其中录制命令。交换链失效/重建时返回 None，本帧应
    跳过。
    """
    ...

def vkEndFrame() -> None:
    """结束一帧：关闭渲染区间 → 提交 → 等待 imageAvailable → present。"""
    ...

def vkSubmitOnce(callback: Callable[[int], None]) -> None:
    """在 rendering 区间外的一次性命令缓冲上执行 callback(cmd_buffer)。

    cmd_buffer 为长整型指针，适合纹理上传等一次性 GPU 操作；提交后等待完成。
    未调用 vkInit 时抛 RuntimeError；回调抛出的异常向上传递。
    """
    ...

